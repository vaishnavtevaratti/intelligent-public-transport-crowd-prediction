# Frontend configuration (copy to .env). Only VITE_* values are exposed to the browser,
# so never put secrets here.
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws

# Map provider: "osm" (OpenStreetMap + Leaflet, free, default) or "google".
VITE_MAP_PROVIDER=osm
# Required only when VITE_MAP_PROVIDER=google. Google needs a billing-enabled Cloud project with the
# "Maps JavaScript API" enabled. Restrict the key: application restriction "Websites" (HTTP referrers, e.g.
# http://localhost:5173/*) and API restriction "Maps JavaScript API" only. Placeholder below - never commit a real key.
VITE_GOOGLE_MAPS_API_KEY=
